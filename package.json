{
  "name": "qoreops",
  "version": "0.1.0",
  "private": true,
  "description": "Working title: QoreChain AI Operations OS. Controlled, auditable AI agents for organisations, settled on QoreChain.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:contracts": "cd contracts && forge test -vv",
    "build:contracts": "cd contracts && forge build",
    "chain:probe": "tsx packages/qorechain/scripts/probe.ts",
    "account:new": "tsx packages/qorechain/scripts/new-account.ts",
    "account:inspect": "tsx packages/qorechain/scripts/account.ts",
    "chain:tx": "tsx packages/qorechain/scripts/chain-tx.ts",
    "qday:account": "tsx packages/qorechain/scripts/qday-account.ts",
    "qday:stack": "tsx packages/qorechain/scripts/qday-stack.ts",
    "qday:verify": "tsx packages/qorechain/scripts/qday-verify.ts",
    "qday:freeze": "tsx packages/qorechain/scripts/qday-freeze.ts",
    "qday:watch": "tsx packages/qorechain/scripts/qday-watch.ts",
    "v2:admin": "tsx packages/qorechain/scripts/v2-admin.ts",
    "v2:setup": "tsx packages/qorechain/scripts/v2-setup.ts",
    "v2:live": "tsx packages/qorechain/scripts/v2-live.ts",
    "v2:admin-action": "tsx packages/qorechain/scripts/v2-admin-action.ts",
    "proof:check": "tsx scripts/verify-doc-hashes.mts",
    "ai:probe": "tsx --env-file=apps/web/.env.local packages/ai-provider/scripts/probe.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@qorechain/qorex-wallet-mock": "0.1.0",
    "@types/node": "^22.10.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
