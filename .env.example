# ---- Copy to .env (never commit .env). Server-only unless prefixed NEXT_PUBLIC_. ----

# Product branding (working title; easy to change)
NEXT_PUBLIC_PRODUCT_NAME="Verac"

# ---- QoreChain Diana testnet (public endpoints, no secrets) ----
NEXT_PUBLIC_QORE_NATIVE_CHAIN_ID=qorechain-diana
NEXT_PUBLIC_QORE_EVM_CHAIN_ID=9800
NEXT_PUBLIC_QORE_EVM_RPC=https://evm-testnet.qore.host
NEXT_PUBLIC_QORE_REST=https://api-testnet.qore.host
NEXT_PUBLIC_QORE_RPC=https://rpc-testnet.qore.host
NEXT_PUBLIC_QORE_EXPLORER=https://explore.qore.network
# Mainnet is intentionally unsupported. The code refuses any chain id other than 9800 / qorechain-diana.

# ---- Deployed contract addresses (fill ONLY after a real testnet deployment) ----
CONTRACT_ORGANIZATION_REGISTRY=
CONTRACT_POLICY_MANAGER=
CONTRACT_TREASURY_VAULT=0xa343930CE94b1d1629791823A75fb14a1D7C7Ab8
CONTRACT_MILESTONE_ESCROW=0xd577FFB031358d46B369E9fE293c5a21a1C1FA90
CONTRACT_AUDIT_ANCHOR=0x4D1dc4ff95dc9443552c3A8Efa7d1a21B4Bdc1C2

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI provider: Google Gemini (free tier only) ----
AI_PROVIDER=gemini
AI_FREE_TIER_ONLY=true
# Server-only. Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free-tier models verified against ai.google.dev/gemini-api/docs/pricing on 2026-11-14.
# Re-check before deploying; model availability changes.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
AI_MAX_CONCURRENCY=2
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=200
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_INPUT_CHARS=24000
AI_TIMEOUT_MS=30000

# ---- Agent messaging ----
# 32+ random bytes, hex. One secret per agent is derived from this via HKDF. Server-only.
AGENT_MESSAGE_ROOT_SECRET=

# ---- Relayer / transaction service (server-only, TESTNET ONLY) ----
# A fresh throwaway testnet account that has never held real funds.
# Prefer a secrets manager; do not paste a mnemonic into chat or commit it.
RELAYER_MNEMONIC=
# Hard cap enforced by the transaction service regardless of policy (uqor; 1 QOR = 1,000,000 uqor).
TX_SERVICE_MAX_UQOR_PER_TX=100000000

# ---- Live execution on Diana testnet (server-only, TESTNET ONLY, OFF by default) ----
# Set these as SENSITIVE variables in Vercel (Settings > Environment Variables), for Production and Preview.
# Never commit values, never paste them in chat, never prefix them NEXT_PUBLIC_.
# Two DIFFERENT throwaway testnet accounts. The agent pays (executePayment/fundEscrow only); the approver relays
# human approvals (approvePayment only). The server refuses to start if they are the same account.
# Create an account with: pnpm account:new .secrets/<name>.json  (keys are saved locally, never printed).
# EVM_PRIVATE_KEY = secp256k1PrivateKey as 0x + 64 hex. MLDSA keys = hex from the same file. The ML-DSA keys are long
# (about 5,200 and 9,800 characters); Vercel allows this.
AGENT_EVM_PRIVATE_KEY=
AGENT_MLDSA_PUBLIC_KEY=
AGENT_MLDSA_SECRET_KEY=
APPROVER_EVM_PRIVATE_KEY=
APPROVER_MLDSA_PUBLIC_KEY=
APPROVER_MLDSA_SECRET_KEY=
# Optional: the server refuses to start if the agent key does not belong to this address.
LIVE_AGENT_ADDRESS=
# How many administrators must approve each live payment in Verac (1 or 2). Default 1.
LIVE_REQUIRED_ADMIN_APPROVALS=1
# Master switch. Anything other than exactly "true" means NOTHING is signed or sent. Leave unset until ready.
LIVE_EXECUTION_ENABLED=
# Emergency stop. "true" stops all signing at once, even if the switch above is on.
LIVE_EMERGENCY_STOP=

# ---- Encryption ----
QORESEAL_CHAIN_ID=qorechain-diana

# ---- Optional notifications ----
NOTIFY_WEBHOOK_URL=
